<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between;">
        <ui:Label text="Title" name="title" style="-unity-text-align: middle-left; width: 150px; text-overflow: ellipsis; flex-shrink: 1; overflow: hidden; margin-left: 2px;"/>
        <ui:Label text="Assets/" name="path" style="text-overflow: ellipsis; flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden;"/>
        <ui:Button name="browse" text="Browse" style="width: 70px;"/>
    </ui:VisualElement>
</ui:UXML>
