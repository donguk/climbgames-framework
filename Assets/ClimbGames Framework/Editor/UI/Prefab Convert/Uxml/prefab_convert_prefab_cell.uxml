<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="status" style="flex-grow: 0; width: 16px; -unity-background-scale-mode: scale-to-fit; margin-right: 2px; margin-left: 6px;"/>
        <uie:ObjectField name="prefab" allow-scene-objects="false" style="flex-grow: 1; -unity-text-align: middle-left; align-items: center;"/>
    </ui:VisualElement>
</ui:UXML>
