<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:Label text="Settings" name="settings" style="-unity-font-style: bold; height: 30px; -unity-text-align: middle-left; margin-left: 2px;"/>
        <ClimbGames.Editor.UI.SelectPathField name="origin_path" title="Origin Prefab Path"/>
        <ClimbGames.Editor.UI.SelectPathField name="convert_path" title="Convert Prefab Path"/>
        <ClimbGames.Editor.UI.SelectPathField name="script_path" title="CodeGen Script Path"/>
        <ClimbGames.Editor.UI.FileTreeView title="Prefab Files" name="prefab_view" style="margin-top: 10px; flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
